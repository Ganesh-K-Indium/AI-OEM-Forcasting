ENVIRONMENT=dev
JWT_SECRET=replace-with-a-long-random-string-32+chars
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
SYNTHETIC_MODE=true
ENABLE_CHRONOS=true
ENABLE_TIREX=false        # NXAI Community License - legal review required before enabling
WITH_FOUNDATION=1         # 0 = skip torch/chronos in the image
# Auth: AUTH_MODE=oidc plus OIDC_JWKS_URL / OIDC_ISSUER / OIDC_AUDIENCE / OIDC_ROLE_CLAIM
